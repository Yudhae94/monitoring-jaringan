<div class="page-head">
  <div>
    <h2>Kategori Kas</h2>
    <p class="page-desc">Kelompok transaksi untuk mempermudah pelaporan keuangan.</p>
  </div>
  <div class="page-actions">
    <a href="/kas" class="btn btn-ghost">← Kas RT</a>
    <button type="button" class="btn btn-primary" data-modal-open="kategoriModal">+ Tambah Kategori</button>
  </div>
</div>

<div class="grid-2">
  <% ['masuk', 'keluar'].forEach(function(tipe){ %>
    <div class="card">
      <div class="card-header">
        <h3><%= tipe === 'masuk' ? '📥 Kategori Pemasukan' : '📤 Kategori Pengeluaran' %></h3>
        <span class="badge badge-neutral">
          <%= kategoriList.filter(k => k.tipe === tipe).length %> kategori
        </span>
      </div>
      <div class="card-body no-pad">
        <% var list = kategoriList.filter(k => k.tipe === tipe); %>
        <% if (list.length === 0) { %>
          <div class="empty-mini">Belum ada kategori <%= tipe %>.</div>
        <% } else { %>
          <div class="list-stack">
            <% list.forEach(function(k){ %>
              <div class="list-row">
                <div class="list-main">
                  <span class="kategori-chip" style="border-color: <%= k.warna %>;">
                    <i class="dot" style="background: <%= k.warna %>;"></i><strong><%= k.nama %></strong>
                  </span>
                </div>
                <div class="action-group">
                  <button type="button" class="btn btn-ghost btn-xs" title="Edit"
                          data-edit-kategori='<%- JSON.stringify({ id: k.id, nama: k.nama, tipe: k.tipe, warna: k.warna }) %>'>✏️</button>
                  <% if (currentUser.role === 'admin') { %>
                    <button type="button" class="btn btn-ghost btn-xs" title="Hapus"
                            data-confirm-form="/kas/kategori/<%= k.id %>"
                            data-confirm-title="Hapus Kategori"
                            data-confirm-message="Hapus kategori &quot;<%= k.nama %>&quot;? Kategori yang masih dipakai transaksi tidak dapat dihapus.">🗑️</button>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>

<!-- Modal tambah/edit kategori -->
<div class="modal-overlay" id="kategoriModal" hidden>
  <div class="modal-box">
    <form method="POST" action="/kas/kategori" id="kategoriForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_method" value="POST" id="kategoriMethod">

      <div class="modal-header">
        <h3 id="kategoriModalTitle">Tambah Kategori</h3>
        <button type="button" class="modal-close" data-modal-close>&times;</button>
      </div>

      <div class="modal-body">
        <div class="form-group">
          <label for="kategori_nama">Nama Kategori <span class="req">*</span></label>
          <input type="text" id="kategori_nama" name="nama" class="form-control" required maxlength="60" placeholder="Contoh: Perbaikan Fasilitas">
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="kategori_tipe">Tipe <span class="req">*</span></label>
            <select id="kategori_tipe" name="tipe" class="form-control" required>
              <option value="masuk">Pemasukan</option>
              <option value="keluar">Pengeluaran</option>
            </select>
          </div>

          <div class="form-group">
            <label for="kategori_warna">Warna</label>
            <input type="color" id="kategori_warna" name="warna" class="form-control form-control-color" value="#64748b">
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" data-modal-close>Batal</button>
        <button type="submit" class="btn btn-primary">💾 Simpan</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/modal-confirm', {
  id: 'deleteModal',
  title: 'Konfirmasi Hapus',
  message: 'Data yang dihapus tidak dapat dikembalikan. Lanjutkan?',
  action: '#'
}) %>
