<%
  const totalNominal = data.reduce(function(s, p) { return s + p.nominal; }, 0);
  const totalCash = data.filter(p => p.method === 'cash').reduce(function(s, p) { return s + p.nominal; }, 0);
  const totalTransfer = data.filter(p => p.method === 'transfer').reduce(function(s, p) { return s + p.nominal; }, 0);

  const cards = [
    { label: 'Total Pembayaran', value: fmt.rupiah(totalNominal), sub: `${pagination.total} transaksi (halaman ini)`, icon: '💳', tone: 'primary' },
    { label: 'Tunai', value: fmt.rupiah(totalCash), icon: '💵', tone: 'success' },
    { label: 'Transfer', value: fmt.rupiah(totalTransfer), icon: '🏦', tone: 'info' }
  ];
%>

<div class="page-head">
  <div>
    <h2>Pembayaran Iuran</h2>
    <p class="page-desc">Riwayat seluruh pembayaran iuran yang tercatat.</p>
  </div>
</div>

<%- include('../partials/info-tabs', {
  tabs: [
    { url: '/iuran/tagihan', label: '📋 Tagihan', key: 'tagihan' },
    { url: '/iuran/generate', label: '⚙️ Generate Massal', key: 'generate' },
    { url: '/iuran/pembayaran', label: '💳 Pembayaran', key: 'pembayaran' },
    { url: '/iuran/jenis', label: '🏷️ Jenis Iuran', key: 'jenis' }
  ],
  active: 'pembayaran'
}) %>

<%- include('../partials/stat-card', { cards }) %>

<%- include('../partials/filter-bar', {
  action: '/iuran/pembayaran',
  resetUrl: '/iuran/pembayaran',
  fields: [
    { name: 'q', label: 'Cari', type: 'search', value: filters.q, placeholder: 'Nama, no. KK, referensi…' },
    { name: 'kk_id', label: 'Kartu Keluarga', type: 'select', value: filters.kk_id, placeholder: 'Semua KK',
      options: kkOptions.map(k => ({ value: k.id, label: k.kepala_keluarga })) },
    { name: 'method', label: 'Metode', type: 'select', value: filters.method, placeholder: 'Semua metode',
      options: [{ value: 'cash', label: 'Tunai' }, { value: 'transfer', label: 'Transfer' }] },
    { name: 'tanggal_dari', label: 'Dari Tanggal', type: 'date', value: filters.tanggal_dari },
    { name: 'tanggal_sampai', label: 'Sampai Tanggal', type: 'date', value: filters.tanggal_sampai }
  ]
}) %>

<div class="card">
  <div class="card-body no-pad">
    <% if (data.length === 0) { %>
      <%- include('../partials/empty-state', {
        emptyIcon: '💳',
        emptyTitle: 'Belum ada pembayaran',
        emptyMessage: 'Pembayaran akan muncul di sini setelah dicatat melalui halaman detail tagihan.',
        emptyUrl: '/iuran/tagihan',
        emptyAction: '📋 Lihat Tagihan'
      }) %>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Tanggal</th>
              <th>Kartu Keluarga</th>
              <th>Jenis / Periode</th>
              <th class="text-right">Nominal</th>
              <th>Metode</th>
              <th>Referensi</th>
              <th>Petugas</th>
              <th class="text-right">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% data.forEach(function(p){ %>
              <tr>
                <td><%= fmt.tanggalID(p.tanggal) %></td>
                <td>
                  <strong><%= p.kepala_keluarga %></strong>
                  <small class="cell-sub">No. <%= p.no_rumah || '-' %></small>
                </td>
                <td>
                  <%= p.jenis_nama %>
                  <small class="cell-sub"><%= fmt.namaBulan(p.periode_bulan, true) %> <%= p.periode_tahun %></small>
                </td>
                <td class="text-right text-success"><strong><%= fmt.rupiah(p.nominal) %></strong></td>
                <td><span class="badge badge-<%= p.method === 'cash' ? 'info' : 'warning' %>"><%= p.method === 'cash' ? 'Tunai' : 'Transfer' %></span></td>
                <td class="text-muted"><%= p.no_referensi || '-' %></td>
                <td class="text-muted"><%= p.petugas || '-' %></td>
                <td class="text-right">
                  <a href="/iuran/tagihan/<%= p.tagihan_id %>" class="btn btn-ghost btn-xs" title="Lihat tagihan">👁️</a>
                  <button type="button" class="btn btn-ghost btn-xs" title="Batalkan"
                          data-confirm-form="/iuran/pembayaran/<%= p.id %>"
                          data-confirm-title="Batalkan Pembayaran"
                          data-confirm-message="Batalkan pembayaran <%= fmt.rupiah(p.nominal) %> dari <%= p.kepala_keluarga %>? Saldo kas akan disesuaikan.">↩️</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/pagination', { pagination, baseUrl: '/iuran/pembayaran' }) %>
<%- include('../partials/modal-confirm', {
  id: 'deleteModal',
  title: 'Konfirmasi',
  message: 'Lanjutkan tindakan ini?',
  action: '#'
}) %>
