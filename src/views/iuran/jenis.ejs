<%
  const periodeLabel = { bulanan: 'Bulanan', tahunan: 'Tahunan', insidental: 'Insidental' };
  const periodeBadge = { bulanan: 'info', tahunan: 'warning', insidental: 'neutral' };
%>

<div class="page-head">
  <div>
    <h2>Jenis Iuran</h2>
    <p class="page-desc">Master jenis iuran yang berlaku di lingkungan <%= rt.label %>.</p>
  </div>
  <div class="page-actions">
    <a href="/iuran/tagihan" class="btn btn-ghost">← Tagihan</a>
    <button type="button" class="btn btn-primary" data-modal-open="jenisModal">+ Tambah Jenis</button>
  </div>
</div>

<%- include('../partials/info-tabs', {
  tabs: [
    { url: '/iuran/tagihan', label: '📋 Tagihan', key: 'tagihan' },
    { url: '/iuran/generate', label: '⚙️ Generate Massal', key: 'generate' },
    { url: '/iuran/pembayaran', label: '💳 Pembayaran', key: 'pembayaran' },
    { url: '/iuran/jenis', label: '🏷️ Jenis Iuran', key: 'jenis' }
  ],
  active: 'jenis'
}) %>

<div class="card">
  <div class="card-body no-pad">
    <% if (jenisList.length === 0) { %>
      <%- include('../partials/empty-state', {
        emptyIcon: '🏷️',
        emptyTitle: 'Belum ada jenis iuran',
        emptyMessage: 'Tambahkan jenis iuran terlebih dahulu sebelum membuat tagihan.'
      }) %>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nama Iuran</th>
              <th>Periode</th>
              <th class="text-right">Nominal</th>
              <th>Keterangan</th>
              <th class="text-center">Tagihan</th>
              <th class="text-right">Terbayar</th>
              <th class="text-right">Tunggakan</th>
              <th>Status</th>
              <% if (currentUser.role === 'admin') { %><th class="text-right">Aksi</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% jenisList.forEach(function(j){ %>
              <tr class="<%= j.is_active ? '' : 'row-inactive' %>">
                <td><strong><%= j.nama %></strong></td>
                <td><span class="badge badge-<%= periodeBadge[j.periode] %>"><%= periodeLabel[j.periode] %></span></td>
                <td class="text-right"><strong><%= fmt.rupiah(j.nominal) %></strong></td>
                <td class="text-muted"><%= j.keterangan || '-' %></td>
                <td class="text-center"><%= j.jumlah_tagihan %></td>
                <td class="text-right text-success"><%= fmt.rupiah(j.total_terbayar) %></td>
                <td class="text-right <%= j.total_tunggakan > 0 ? 'text-danger' : '' %>"><%= fmt.rupiah(j.total_tunggakan) %></td>
                <td>
                  <span class="badge badge-<%= j.is_active ? 'success' : 'neutral' %>">
                    <%= j.is_active ? 'Aktif' : 'Nonaktif' %>
                  </span>
                </td>
                <% if (currentUser.role === 'admin') { %>
                  <td class="text-right">
                    <div class="action-group">
                      <button type="button" class="btn btn-ghost btn-xs" title="Edit"
                              data-edit-jenis='<%- JSON.stringify({ id: j.id, nama: j.nama, periode: j.periode, nominal: j.nominal, keterangan: j.keterangan || '' }) %>'>✏️</button>
                      <button type="button" class="btn btn-ghost btn-xs" title="Hapus"
                              data-confirm-form="/iuran/jenis/<%= j.id %>"
                              data-confirm-title="Hapus Jenis Iuran"
                              data-confirm-message="Hapus jenis iuran &quot;<%= j.nama %>&quot;? Jika sudah dipakai, jenis akan dinonaktifkan.">🗑️</button>
                    </div>
                  </td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- Modal tambah/edit jenis iuran -->
<div class="modal-overlay" id="jenisModal" hidden>
  <div class="modal-box">
    <form method="POST" action="/iuran/jenis" id="jenisForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_method" value="POST" id="jenisMethod">

      <div class="modal-header">
        <h3 id="jenisModalTitle">Tambah Jenis Iuran</h3>
        <button type="button" class="modal-close" data-modal-close>&times;</button>
      </div>

      <div class="modal-body">
        <div class="form-group">
          <label for="jenis_nama">Nama Iuran <span class="req">*</span></label>
          <input type="text" id="jenis_nama" name="nama" class="form-control" required maxlength="80" placeholder="Contoh: Iuran Kebersihan">
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="jenis_periode">Periode <span class="req">*</span></label>
            <select id="jenis_periode" name="periode" class="form-control" required>
              <option value="bulanan">Bulanan</option>
              <option value="tahunan">Tahunan</option>
              <option value="insidental">Insidental</option>
            </select>
          </div>

          <div class="form-group">
            <label for="jenis_nominal">Nominal (Rp) <span class="req">*</span></label>
            <input type="number" id="jenis_nominal" name="nominal" class="form-control" required min="0" step="500" placeholder="50000">
          </div>
        </div>

        <div class="form-group">
          <label for="jenis_keterangan">Keterangan</label>
          <textarea id="jenis_keterangan" name="keterangan" class="form-control" rows="2" maxlength="255" placeholder="Deskripsi singkat iuran"></textarea>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" data-modal-close>Batal</button>
        <button type="submit" class="btn btn-primary">💾 Simpan</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/modal-confirm', {
  id: 'deleteModal',
  title: 'Konfirmasi Hapus',
  message: 'Data yang dihapus tidak dapat dikembalikan. Lanjutkan?',
  action: '#'
}) %>
