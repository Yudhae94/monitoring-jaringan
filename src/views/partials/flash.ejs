<% if (hasFlash) { %>
  <div class="flash-area">
    <% if (flash.success) { %>
      <div class="flash flash-success" role="alert">
        <span class="flash-icon">✓</span>
        <span class="flash-text"><%= flash.success %></span>
        <button class="flash-close" aria-label="Tutup">&times;</button>
      </div>
    <% } %>
    <% if (flash.error) { %>
      <div class="flash flash-error" role="alert">
        <span class="flash-icon">!</span>
        <span class="flash-text"><%= flash.error %></span>
        <button class="flash-close" aria-label="Tutup">&times;</button>
      </div>
    <% } %>
    <% if (flash.info) { %>
      <div class="flash flash-info" role="alert">
        <span class="flash-icon">i</span>
        <span class="flash-text"><%= flash.info %></span>
        <button class="flash-close" aria-label="Tutup">&times;</button>
      </div>
    <% } %>
  </div>
<% } %>
