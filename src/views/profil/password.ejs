<div class="page-head">
  <div>
    <h2>Ubah Password</h2>
    <p class="page-desc">Gunakan password yang kuat dan tidak mudah ditebak.</p>
  </div>
  <div class="page-actions">
    <a href="/profil" class="btn btn-ghost">← Profil</a>


<div class="form-layout-narrow">
  <div class="card">
    <div class="card-header"><h3>🔒 Keamanan Akun</h3>  </div>
</div>
</div>
    <div class="card-body">
      <form method="POST" action="/profil/password?_method=PUT">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="_method" value="PUT">

        <div class="form-group">
          <label for="password_lama">Password Lama <span class="req">*</span></label>
          <input type="password" id="password_lama" name="password_lama" class="form-control"
                 required placeholder="Masukkan password saat ini" autocomplete="current-password">
  </div>

        <div class="form-group">
          <label for="password_baru">Password Baru <span class="req">*</span></label>
          <input type="password" id="password_baru" name="password_baru" class="form-control"
                 required minlength="6" placeholder="Minimal 6 karakter" autocomplete="new-password">
          <div class="strength-meter" id="strengthMeter">
            <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
            <span class="strength-text" id="strengthText">Kekuatan password</span>
          </div>
        </div>

        <div class="form-group">
          <label for="konfirmasi_password">Konfirmasi Password Baru <span class="req">*</span></label>
          <input type="password" id="konfirmasi_password" name="konfirmasi_password" class="form-control"
                 required minlength="6" placeholder="Ulangi password baru" autocomplete="new-password">
          <small class="form-hint" id="matchHint"></small>
        </div>

        <div class="form-actions-inline">
          <button type="submit" class="btn btn-primary">🔒 Ubah Password</button>
          <a href="/profil" class="btn btn-ghost">Batal</a>
        </div>
      </form>
    </div>
  </div>

  <div class="info-box">
    <strong>🛡️ Tips password aman:</strong>
    <ul class="bullet-list">
      <li>Minimal 8 karakter, kombinasikan huruf besar, kecil, angka, dan simbol.</li>
      <li>Jangan gunakan tanggal lahir, nama, atau nomor HP.</li>
      <li>Jangan gunakan password yang sama dengan akun lain.</li>
      <li>Ganti password secara berkala.</li>
    </ul>
  </div>
</div>

<script>
  (function () {
    var baru = document.getElementById('password_baru');
    var konfirmasi = document.getElementById('konfirmasi_password');
    var fill = document.getElementById('strengthFill');
    var text = document.getElementById('strengthText');
    var matchHint = document.getElementById('matchHint');

    function hitungKekuatan(pw) {
      var skor = 0;
      if (pw.length >= 6) skor += 1;
      if (pw.length >= 10) skor += 1;
      if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) skor += 1;
      if (/\d/.test(pw)) skor += 1;
      if (/[^A-Za-z0-9]/.test(pw)) skor += 1;
      return Math.min(skor, 4);
    }

    var level = [
      { w: '0%',   c: '#e2e8f0', t: 'Kekuatan password' },
      { w: '25%',  c: '#ef4444', t: 'Sangat lemah' },
      { w: '50%',  c: '#f59e0b', t: 'Lemah' },
      { w: '75%',  c: '#0ea5e9', t: 'Cukup kuat' },
      { w: '100%', c: '#16a34a', t: 'Sangat kuat' }
    ];

    baru.addEventListener('input', function () {
      var s = hitungKekuatan(baru.value);
      var l = baru.value ? level[s] : level[0];
      fill.style.width = l.w;
      fill.style.background = l.c;
      text.textContent = l.t;
      text.style.color = l.c;
    });

    function cekCocok() {
      if (!konfirmasi.value) { matchHint.textContent = ''; return; }
      if (baru.value === konfirmasi.value) {
        matchHint.textContent = '✓ Password cocok';
        matchHint.className = 'form-hint text-success';
      } else {
        matchHint.textContent = '✗ Password belum cocok';
        matchHint.className = 'form-hint text-danger';
      }
    }

    konfirmasi.addEventListener('input', cekCocok);
    baru.addEventListener('input', cekCocok);
  })();
</script>
