<%
  const isPengurus = ['admin', 'bendahara'].includes(currentUser.role);
  const useWargaData = wargaSaya && !isPengurus;
%>

<div class="page-head">
  <div>
    <h2>Ajukan Surat</h2>
    <p class="page-desc">Isi formulir berikut untuk mengajukan surat keterangan ke pengurus <%= rt.label %>.</p>
  </div>
  <div class="page-actions">
    <a href="/surat" class="btn btn-ghost">← Kembali</a>


<% if (useWargaData) { %>
  <div class="info-box">
    <strong>ℹ️ Data pemohon otomatis:</strong>
    Formulir telah terisi dari data warga Anda (<strong><%= wargaSaya.nama %></strong> — NIK <%= wargaSaya.nik %>).
    Nomor surat akan dibuat otomatis oleh sistem.
    </div>
</div>
</div>
<% } %>

<form method="POST" action="/surat/ajukan" class="form-layout">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card">
    <div class="card-header"><h3>Informasi Surat</h3></div>
    <div class="card-body">
      <div class="form-grid">
        <div class="form-group form-group-full">
          <label for="jenis_surat_id">Jenis Surat <span class="req">*</span></label>
          <select id="jenis_surat_id" name="jenis_surat_id" class="form-control" required>
            <option value="">— Pilih Jenis Surat —</option>
            <% jenisOptions.forEach(function(j){ %>
              <option value="<%= j.id %>" <%= String(query.jenis_surat_id || '') === String(j.id) ? 'selected' : '' %>>
                <%= j.nama %> (<%= j.kode %>)
              </option>
            <% }); %>
          </select>
        </div>

        <% if (isPengurus) { %>
          <div class="form-group form-group-full">
            <label for="warga_id">Warga yang Bersangkutan</label>
            <select id="warga_id" name="warga_id" class="form-control">
              <option value="">— Pilih dari data warga (opsional) —</option>
              <% wargaOptions.forEach(function(w){ %>
                <option value="<%= w.id %>"><%= w.nama %> — NIK <%= w.nik %></option>
              <% }); %>
            </select>
            <small class="form-hint">Bila memilih, NIK akan terisi otomatis.</small>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Data Pemohon</h3></div>
    <div class="card-body">
      <div class="form-grid">
        <div class="form-group">
          <label for="nama_pemohon">Nama Pemohon <span class="req">*</span></label>
          <input type="text" id="nama_pemohon" name="nama_pemohon" class="form-control"
                 value="<%= useWargaData ? wargaSaya.nama : '' %>"
                 required maxlength="100" placeholder="Nama lengkap pemohon"
                 <%= useWargaData ? 'readonly' : '' %>>
        </div>

        <div class="form-group">
          <label for="nik_pemohon">NIK Pemohon</label>
          <input type="text" id="nik_pemohon" name="nik_pemohon" class="form-control"
                 value="<%= useWargaData ? wargaSaya.nik : '' %>"
                 maxlength="16" inputmode="numeric" placeholder="16 digit angka"
                 <%= useWargaData ? 'readonly' : '' %>>
        </div>

        <div class="form-group">
          <label for="no_hp">Nomor HP</label>
          <input type="text" id="no_hp" name="no_hp" class="form-control"
                 value="<%= useWargaData && wargaSaya.no_hp ? wargaSaya.no_hp : (user.no_hp || '') %>"
                 maxlength="20" placeholder="08xxxxxxxxxx">
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Keperluan</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label for="keperluan">Keperluan Surat <span class="req">*</span></label>
        <input type="text" id="keperluan" name="keperluan" class="form-control"
               required maxlength="255" placeholder="Contoh: Persyaratan pendaftaran sekolah anak">
      </div>

      <div class="form-group">
        <label for="keterangan">Keterangan Tambahan</label>
        <textarea id="keterangan" name="keterangan" class="form-control" rows="3" maxlength="500"
                  placeholder="Informasi lain yang perlu diketahui pengurus (opsional)"></textarea>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">✉️ Kirim Pengajuan</button>
    <a href="/surat" class="btn btn-ghost">Batal</a>
  </div>
</form>

<script>
  (function () {
    var wargaSel = document.getElementById('warga_id');
    if (!wargaSel) return;

    var namaInput = document.getElementById('nama_pemohon');
    var nikInput = document.getElementById('nik_pemohon');

    wargaSel.addEventListener('change', function () {
      var opt = wargaSel.options[wargaSel.selectedIndex];
      if (!opt || !opt.value) return;

      // Format label: "Nama — NIK 1234..."
      var label = opt.textContent.trim();
      var parts = label.split('—');
      if (parts.length === 2) {
        namaInput.value = parts[0].trim();
        nikInput.value = parts[1].replace('NIK', '').trim();
      }
    });
  })();
</script>
