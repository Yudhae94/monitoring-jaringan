<%
  const isEdit = Boolean(pengumumanData);
  const action = isEdit ? `/pengumuman/${pengumumanData.id}` : '/pengumuman';
  const v = (field, fallback) => {
    if (isEdit) return pengumumanData[field] === null || pengumumanData[field] === undefined ? '' : pengumumanData[field];
    return typeof fallback !== 'undefined' ? fallback : '';
  };
  const prio = v('prioritas', 'normal');
  const published = String(v('is_publish', 1)) === '1';
%>

<div class="page-head">
  <div>
    <h2><%= isEdit ? 'Edit Pengumuman' : 'Buat Pengumuman' %></h2>
    <p class="page-desc">Pengumuman akan tampil di dashboard warga dan halaman pengumuman.</p>
  </div>
  <div class="page-actions">
    <a href="<%= isEdit ? '/pengumuman/' + pengumumanData.id : '/pengumuman' %>" class="btn btn-ghost">← Kembali</a>


<form method="POST" action="<%= action %>" class="form-layout">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (isEdit) { %><input type="hidden" name="_method" value="PUT"><% } %>

  <div class="card">
    <div class="card-header"><h3>Isi Pengumuman</h3>  </div>
</div>
</div>
    <div class="card-body">
      <div class="form-group">
        <label for="judul">Judul <span class="req">*</span></label>
        <input type="text" id="judul" name="judul" class="form-control"
               value="<%= v('judul') %>" required maxlength="150"
               placeholder="Contoh: Kerja Bakti Bulan Ini">
  </div>

      <div class="form-group">
        <label for="isi">Isi Pengumuman <span class="req">*</span></label>
        <textarea id="isi" name="isi" class="form-control" rows="8" required
                  placeholder="Tuliskan isi pengumuman secara lengkap. Gunakan enter untuk memisahkan paragraf."><%= v('isi') %></textarea>
        <small class="form-hint">Setiap baris baru akan menjadi paragraf terpisah.</small>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3>Pengaturan</h3></div>
    <div class="card-body">
      <div class="form-grid">
        <div class="form-group">
          <label for="prioritas">Prioritas <span class="req">*</span></label>
          <select id="prioritas" name="prioritas" class="form-control" required>
            <option value="normal" <%= prio === 'normal' ? 'selected' : '' %>>Normal — informasi umum</option>
            <option value="penting" <%= prio === 'penting' ? 'selected' : '' %>>Penting — perlu perhatian</option>
            <option value="urgent" <%= prio === 'urgent' ? 'selected' : '' %>>Urgent — mendesak</option>
          </select>
        </div>

        <div class="form-group">
          <label for="is_publish">Status Publikasi</label>
          <select id="is_publish" name="is_publish" class="form-control">
            <option value="1" <%= published ? 'selected' : '' %>>Langsung Publikasikan</option>
            <option value="0" <%= !published ? 'selected' : '' %>>Simpan sebagai Draft</option>
          </select>
        </div>

        <div class="form-group">
          <label for="tanggal_mulai">Tanggal Mulai Berlaku <span class="req">*</span></label>
          <input type="date" id="tanggal_mulai" name="tanggal_mulai" class="form-control"
                 value="<%= fmt.toDateInput(v('tanggal_mulai', new Date())) %>" required>
        </div>

        <div class="form-group">
          <label for="tanggal_selesai">Tanggal Berakhir</label>
          <input type="date" id="tanggal_selesai" name="tanggal_selesai" class="form-control"
                 value="<%= fmt.toDateInput(v('tanggal_selesai')) %>">
          <small class="form-hint">Kosongkan bila pengumuman berlaku tanpa batas waktu.</small>
        </div>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><%= isEdit ? '💾 Simpan Perubahan' : '📢 Terbitkan Pengumuman' %></button>
    <a href="/pengumuman" class="btn btn-ghost">Batal</a>
  </div>
</form>
