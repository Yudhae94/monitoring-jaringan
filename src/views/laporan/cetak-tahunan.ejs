<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= laporan.judul %> — <%= laporan.rt.label %></title>
  <link rel="stylesheet" href="/css/print.css">
</head>
<body>

  <div class="toolbar no-print">
    <a href="/laporan/tahunan?tahun=<%= laporan.periode.tahun %>" class="btn-back">← Kembali</a>
    <button type="button" class="btn-print" onclick="window.print()">🖨️ Cetak / Simpan PDF</button>
  </div>

  <div class="sheet">

    <div class="kop">
      <div class="kop-logo">🏘️</div>
      <div class="kop-text">
        <div class="l1">PENGURUS RUKUN TETANGGA <%= laporan.rt.number %> / RUKUN WARGA <%= laporan.rt.rw %></div>
        <div class="l2">KELURAHAN <%= laporan.rt.kelurahan.toUpperCase() %> KECAMATAN <%= laporan.rt.kecamatan.toUpperCase() %></div>
        <div class="l3"><%= laporan.rt.kota.toUpperCase() %>, <%= laporan.rt.provinsi.toUpperCase() %></div>
        <div class="l4"><%= laporan.rt.alamat %>, Kode Pos <%= laporan.rt.kodePos %></div>
      </div>
    </div>
    <div class="kop-line"></div>

    <div class="judul">
      <h1><%= laporan.judul.toUpperCase() %></h1>
      <div class="periode">Tahun Anggaran <%= laporan.periode.tahun %></div>
    </div>

    <h2 class="section-title">A. REKAPITULASI KAS PER BULAN</h2>
    <table class="tbl tbl-grid">
      <thead>
        <tr>
          <th>Bulan</th>
          <th class="w-money">Pemasukan</th>
          <th class="w-money">Pengeluaran</th>
          <th class="w-money">Selisih</th>
        </tr>
      </thead>
      <tbody>
        <% laporan.rekapKas.forEach(function(r){ %>
          <tr>
            <td><%= fmt.namaBulan(r.bulan) %></td>
            <td class="text-right"><%= r.masuk > 0 ? fmt.rupiah(r.masuk) : '-' %></td>
            <td class="text-right"><%= r.keluar > 0 ? fmt.rupiah(r.keluar) : '-' %></td>
            <td class="text-right"><%= fmt.rupiah(r.saldo) %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr class="row-total">
          <td>TOTAL</td>
          <td class="text-right"><%= fmt.rupiah(laporan.total.total_masuk) %></td>
          <td class="text-right"><%= fmt.rupiah(laporan.total.total_keluar) %></td>
          <td class="text-right"><%= fmt.rupiah(laporan.total.saldo) %></td>
        </tr>
      </tfoot>
    </table>

    <h2 class="section-title">B. REKAPITULASI IURAN PER BULAN</h2>
    <table class="tbl tbl-grid">
      <thead>
        <tr>
          <th>Bulan</th>
          <th class="w-money">Target</th>
          <th class="w-money">Realisasi</th>
          <th class="w-money">Selisih</th>
          <th class="w-num">%</th>
        </tr>
      </thead>
      <tbody>
        <% laporan.rekapIuran.forEach(function(r){ %>
          <% var pct = r.target > 0 ? Math.round((r.realisasi / r.target) * 100) : 0; %>
          <tr>
            <td><%= fmt.namaBulan(r.bulan) %></td>
            <td class="text-right"><%= r.target > 0 ? fmt.rupiah(r.target) : '-' %></td>
            <td class="text-right"><%= r.realisasi > 0 ? fmt.rupiah(r.realisasi) : '-' %></td>
            <td class="text-right"><%= (r.target - r.realisasi) > 0 ? fmt.rupiah(r.target - r.realisasi) : '-' %></td>
            <td class="text-right"><%= r.target > 0 ? pct + '%' : '-' %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr class="row-total">
          <td>TOTAL</td>
          <td class="text-right"><%= fmt.rupiah(laporan.iuranTotal.total_nominal) %></td>
          <td class="text-right"><%= fmt.rupiah(laporan.iuranTotal.total_terbayar) %></td>
          <td class="text-right"><%= fmt.rupiah(laporan.iuranTotal.total_tunggakan) %></td>
          <td class="text-right">
            <%= laporan.iuranTotal.total_nominal > 0
              ? Math.round((laporan.iuranTotal.total_terbayar / laporan.iuranTotal.total_nominal) * 100) + '%'
              : '-' %>
          </td>
        </tr>
      </tfoot>
    </table>

    <div class="two-col">
      <div>
        <h2 class="section-title">C. PEMASUKAN PER KATEGORI</h2>
        <table class="tbl tbl-grid">
          <thead>
            <tr><th>Kategori</th><th class="w-money">Jumlah</th></tr>
          </thead>
          <tbody>
            <% if (laporan.pemasukanKategori.length === 0) { %>
              <tr><td colspan="2" class="text-center">Tidak ada data</td></tr>
            <% } else { %>
              <% laporan.pemasukanKategori.forEach(function(k){ %>
                <tr><td><%= k.nama %></td><td class="text-right"><%= fmt.rupiah(k.total) %></td></tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <div>
        <h2 class="section-title">D. PENGELUARAN PER KATEGORI</h2>
        <table class="tbl tbl-grid">
          <thead>
            <tr><th>Kategori</th><th class="w-money">Jumlah</th></tr>
          </thead>
          <tbody>
            <% if (laporan.pengeluaranKategori.length === 0) { %>
              <tr><td colspan="2" class="text-center">Tidak ada data</td></tr>
            <% } else { %>
              <% laporan.pengeluaranKategori.forEach(function(k){ %>
                <tr><td><%= k.nama %></td><td class="text-right"><%= fmt.rupiah(k.total) %></td></tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <h2 class="section-title">E. DAFTAR TUNGGAKAN IURAN</h2>
    <table class="tbl tbl-grid">
      <thead>
        <tr>
          <th class="w-no">No</th>
          <th>Kepala Keluarga</th>
          <th class="w-acc">No. KK</th>
          <th class="w-num">No. Rumah</th>
          <th class="w-num">Jml Tagihan</th>
          <th class="w-money">Total Tunggakan</th>
        </tr>
      </thead>
      <tbody>
        <% if (laporan.tunggakan.length === 0) { %>
          <tr><td colspan="6" class="text-center">Tidak ada tunggakan pada tahun ini.</td></tr>
        <% } else { %>
          <% laporan.tunggakan.forEach(function(t, i){ %>
            <tr>
              <td class="text-center"><%= i + 1 %></td>
              <td><%= t.kepala_keluarga %></td>
              <td><%= t.no_kk %></td>
              <td class="text-center"><%= t.no_rumah || '-' %></td>
              <td class="text-center"><%= t.jumlah_tagihan %></td>
              <td class="text-right"><%= fmt.rupiah(t.total_tunggakan) %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
      <tfoot>
        <tr class="row-total">
          <td colspan="5" class="text-right">TOTAL TUNGGAKAN</td>
          <td class="text-right"><%= fmt.rupiah(laporan.tunggakan.reduce((s, t) => s + t.total_tunggakan, 0)) %></td>
        </tr>
      </tfoot>
    </table>

    <div class="ttd-wrap">
      <div class="ttd-block">
        <div class="ttd-city"><%= laporan.rt.kota %>, <%= new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }).format(tanggalCetak) %></div>
        <div class="ttd-role">Bendahara <%= laporan.rt.label %></div>
        <div class="ttd-space"></div>
        <div class="ttd-name"><%= laporan.rt.bendahara %></div>
      </div>
      <div class="ttd-block">
        <div class="ttd-city"><%= laporan.rt.kota %>, <%= new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }).format(tanggalCetak) %></div>
        <div class="ttd-role">Ketua <%= laporan.rt.label %></div>
        <div class="ttd-space"></div>
        <div class="ttd-name"><%= laporan.rt.ketua %></div>
      </div>
    </div>

    <div class="doc-footer">
      Dicetak dari Sistem Informasi Manajemen RT pada
      <%= new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(tanggalCetak) %> WIB
    </div>
  </div>

</body>
</html>
